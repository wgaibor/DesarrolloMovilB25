<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".DetailsActivity">


    <ImageView
        android:id="@+id/img_detalle_personaje"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_margin="@dimen/dimen_20dp"
        app:srcCompat="@drawable/ic_launcher_background" />

    <TextView
        android:id="@+id/tv_detalle_nombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textSize="@dimen/dimen_texto_20sp"
        android:textStyle="bold"
        android:textColor="@color/orange"
        android:text="WALTHER JOAO"/>

    <TextView
        android:id="@+id/tv_detalle_ocupacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dimen_8dp"
        android:gravity="center"
        android:text="DESARROLLADOR"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dimen_8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_detalle_edad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dimen_20dp"
            android:padding="@dimen/dimen_14dp"
            android:textSize="@dimen/dimen_texto_16sp"
            android:textStyle="bold"
            android:background="@drawable/rectangle_textview"
            android:text="44"/>

        <TextView
            android:id="@+id/tv_detalle_estado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_20dp"
            android:padding="@dimen/dimen_14dp"
            android:textSize="@dimen/dimen_texto_16sp"
            android:textStyle="bold"
            android:background="@drawable/rectangle_alive_textview"
            android:text="vivo"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_detalle_frase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dimen_8dp"
        android:text="frase"
        />

</LinearLayout>